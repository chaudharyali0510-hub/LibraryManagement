@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<div id="chatbot-container"
     class="chatbot-container"
     data-webhook-url="@Configuration["N8N:WebhookUrl"]">

    <button id="chatbot-btn" class="chatbot-btn" onclick="openChat()" aria-label="Open AI Library Assistant">
        <span class="btn-pulse"></span>
        <i class="fas fa-robot"></i>
    </button>

    <div id="chatbot-window" class="chatbot-window" role="dialog" aria-label="AI Library Assistant Chat">
        <div class="chatbot-header">
            <div class="chatbot-header-icon">
                <i class="fas fa-robot"></i>
            </div>
            <div class="chatbot-header-info">
                <span class="chatbot-header-title">AI Library Assistant</span>
                <span class="chatbot-header-status">Online</span>
            </div>
            <button class="chatbot-close-btn" onclick="closeChat()" aria-label="Close chat">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div id="chatbot-messages" class="chatbot-messages"></div>

        <div class="chatbot-input-area">
            <div style="display:flex;align-items:center;gap:8px;width:100%;">
                <div style="flex:1;position:relative;">
                    <input id="chatbot-input"
                           class="chatbot-input"
                           type="text"
                           maxlength="500"
                           placeholder="Ask about books..."
                           autocomplete="off" />
                </div>
                <button id="chatbot-send" class="chatbot-send-btn" onclick="sendMessage()" disabled aria-label="Send message">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:2px 16px 8px;">
            <span id="chatbot-charcount" class="chatbot-char-count">0/500</span>
            <button class="chatbot-clear-btn" onclick="clearChat()">
                <i class="fas fa-trash-alt"></i> Clear chat
            </button>
        </div>
    </div>
</div>
